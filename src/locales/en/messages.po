msgstr "{mpCount} MPs in the Sejm. Find your constituency by town or an MP by surname."

#: src/components/education/EducationStepAccordion/EducationStepAccordion.tsx:465
msgid "bez większości 3/5 ustawa nie dochodzi do skutku"
msgstr "without a 3/5 majority the act fails"

#. js-lingui-explicit-id
#: src/components/mps/MpVoteBadge/MpVoteBadge.constants.ts:21
